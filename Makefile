# Place the UEFI loader and kernel on the ESP. The apps target builds the application ELFs.
# Attach a separate data disk for run and run-gui. Use a disposable disk for test.
# Host settings are generated by ./configure; no tool discovery happens here.
.DEFAULT_GOAL := all
ifeq ($(wildcard config.mk),)
$(error Missing config.mk. Run ./configure first)
endif
include config.mk
DATA_DISK ?= build/data.img

ESP := build/uefi-esp
KERNEL := $(ESP)/kernel.elf
BOOT_EFI := $(ESP)/EFI/BOOT/BOOTX64.EFI
SOURCES := $(wildcard source/*.d)
EFI_SOURCES := $(wildcard boot/*.d) source/boot_info.d source/calendar.d source/cpu.d source/runtime.d source/serial.d
EFI_D_FLAGS := -mtriple=x86_64-pc-windows-msvc -betterC -O2 -checkaction=halt -Iboot -Isource
FONT_ATLASES := $(wildcard assets/fonts/*.coverage)
FONT_LICENSE := assets/fonts/OFL.txt
PHOBOS_APP_ELFS := build/apps/d_base64.elf build/apps/d_crc.elf build/apps/d_sha.elf
D_APP_ELFS := build/apps/d_init.elf build/apps/d_heap.elf build/apps/d_exception.elf build/apps/d_array.elf \
              $(PHOBOS_APP_ELFS)
BUILTIN_GUI_ELFS := $(addprefix build/apps/,$(addsuffix .elf,calc game monitor files editor))
GUI_APP_ELFS := $(BUILTIN_GUI_ELFS) build/apps/counter.elf
APP_ELFS := build/apps/file_limits.elf build/apps/gui_close.elf build/apps/sleep.elf build/apps/vm.elf build/apps/hello.elf $(GUI_APP_ELFS) $(D_APP_ELFS)
GUI_COMMON := apps/builtin/gui_main.d apps/builtin/app_files.d apps/user_api.d \
              source/gui_abi.d source/file_api.d source/app_registry.d source/desktop_theme.d source/graphics.d source/numbers.d source/runtime.d
GUI_INPUTS := $(GUI_COMMON) source/user_abi.d source/font.d source/ps2.d $(FONT_ATLASES) apps/app.ld Makefile config.mk
BETTERC_APP_SUPPORT := apps/user_api.d source/user_abi.d apps/app.ld Makefile config.mk
D_APP_RUNTIME := apps/d_start.d apps/runtime/object.d apps/runtime/d_allocation.d \
                 apps/user_api.d source/user_abi.d source/runtime.d
D_APP_UNWIND := build/apps/d_unwind.o

D_FLAGS := -mtriple=x86_64-unknown-none-elf -betterC -O2 -checkaction=halt \
           -relocation-model=static -code-model=kernel -disable-red-zone \
           -mattr=-mmx,-sse,-sse2 -Isource -Jassets/fonts -Jbuild/apps
APP_D_FLAGS := -mtriple=x86_64-unknown-none-elf -O2 -checkaction=halt \
               -relocation-model=static -disable-red-zone -mattr=-mmx,-sse,-sse2 -Isource -Iapps
FULL_D_FLAGS := $(APP_D_FLAGS) -Iapps/runtime -fno-moduleinfo-localclasses -exception-model=sjlj
APP_LINK_FLAGS := -link-internally -defaultlib= -L=-nostdlib -L=--gc-sections \
                  -L=--strip-all -L=-z -L=max-page-size=4096 -L=-T -L=apps/app.ld

QEMU_FLAGS = -machine pc,accel=tcg -m 128M -nic none -no-reboot \
             -drive "if=pflash,format=raw,readonly=on,file=$(OVMF_CODE)" \
             -drive "if=none,id=esp,format=raw,readonly=on,file=fat:$(abspath $(ESP))" \
             -device virtio-blk-pci,drive=esp,bootindex=1 \
             -monitor none -serial stdio
DATA_DRIVE = -drive "if=ide,index=0,format=raw,file=$(abspath $(DATA_DISK))"
INSTALL_APPS = "$(PYTHON)" tools/install-apps.py $(foreach app,$(GUI_APP_ELFS),--app "$(app)")
INSTALL_QEMU = -- "$(QEMU)" $(QEMU_FLAGS) -display none

.DELETE_ON_ERROR:
.PHONY: all apps install-apps run run-gui test check-ovmf

all: $(KERNEL) $(BOOT_EFI) $(ESP)/FONT-LICENSE.txt
apps: $(APP_ELFS)

# Pass the dependent module first in LDC's registration list to test initialization order.
build/apps/d_init.elf: apps/experiments/d_init.d apps/experiments/d_init_dependency.d
build/apps/d_heap.elf: apps/experiments/d_heap.d
build/apps/d_exception.elf: apps/experiments/d_exception.d
build/apps/d_array.elf: apps/experiments/d_array.d
build/apps/d_base64.elf: apps/experiments/d_base64.d build/apps/phobos/base64.o
build/apps/d_crc.elf: apps/experiments/d_crc.d build/apps/phobos/digest/crc.o build/apps/phobos/ascii.o
build/apps/d_sha.elf: apps/experiments/d_sha.d build/apps/phobos/digest/sha.o build/apps/phobos/ascii.o

$(PHOBOS_APP_ELFS): APP_IMPORT_FLAGS = -I"$(PHOBOS_IMPORT)"

$(D_APP_ELFS): $(D_APP_RUNTIME) $(D_APP_UNWIND) apps/app.ld Makefile config.mk
	mkdir -p "$(@D)"
	"$(LDC)" $(FULL_D_FLAGS) -Iapps/experiments $(APP_IMPORT_FLAGS) $(APP_LINK_FLAGS) -L=--entry=main -of="$@" \
		$(filter-out $(D_APP_RUNTIME),$(filter %.d,$^)) $(D_APP_RUNTIME) $(filter %.o,$^)
	@test "$$(wc -c < "$@")" -le 1048576 || { echo "App exceeds DlangFS file size limit." >&2; exit 1; }

# Compile the Phobos sources bundled with LDC into ELF objects for the application target.
# Keep SHA small enough for existing 16 KiB DlangFS3 volumes.
build/apps/phobos/digest/sha.o: FULL_D_FLAGS := $(filter-out -O2,$(FULL_D_FLAGS)) -Os

build/apps/phobos/%.o: $(PHOBOS_IMPORT)/std/%.d apps/runtime/object.d apps/runtime/d_allocation.d Makefile config.mk
	mkdir -p "$(@D)"
	"$(LDC)" $(FULL_D_FLAGS) -I"$(PHOBOS_IMPORT)" -c -of="$@" "$<"

# Build the unwinder separately so LLVM optimization preserves the application's exception edges.
$(D_APP_UNWIND): apps/runtime/d_unwind.d $(D_APP_RUNTIME) Makefile config.mk
	mkdir -p "$(@D)"
	"$(LDC)" $(FULL_D_FLAGS) -fno-moduleinfo -c -of="$@" "$<"

build/apps/file_limits.elf: apps/experiments/file_limits.d $(BETTERC_APP_SUPPORT) source/gui_abi.d source/file_api.d

build/apps/gui_close.elf: apps/experiments/gui_close.d $(BETTERC_APP_SUPPORT) source/gui_abi.d source/file_api.d
build/apps/sleep.elf: apps/experiments/sleep.d $(BETTERC_APP_SUPPORT)
build/apps/vm.elf: apps/experiments/vm.d $(BETTERC_APP_SUPPORT)
build/apps/hello.elf: apps/experiments/hello.d $(BETTERC_APP_SUPPORT)
build/apps/counter.elf: apps/counter/counter.d $(BETTERC_APP_SUPPORT) source/gui_abi.d source/file_api.d

build/apps/file_limits.elf build/apps/gui_close.elf build/apps/sleep.elf build/apps/vm.elf build/apps/hello.elf build/apps/counter.elf:
	mkdir -p "$(@D)"
	"$(LDC)" $(APP_D_FLAGS) $(APP_LINK_FLAGS) -betterC -of="$@" "$<" apps/user_api.d
	@test "$$(wc -c < "$@")" -le 1048576 || { echo "App exceeds DlangFS file size limit." >&2; exit 1; }

build/apps/calc.elf: GUI_VERSION := CalcApp
build/apps/calc.elf: apps/builtin/calculator.d
build/apps/game.elf: GUI_VERSION := GameApp
build/apps/game.elf: apps/builtin/snake.d
build/apps/monitor.elf: GUI_VERSION := MonitorApp
build/apps/monitor.elf: apps/builtin/monitor.d
build/apps/files.elf: GUI_VERSION := FilesApp
build/apps/files.elf: apps/builtin/file_browser.d
build/apps/editor.elf: GUI_VERSION := EditorApp
# Keep Editor compatible with existing 16 KiB DlangFS3 volumes.
build/apps/editor.elf: APP_D_FLAGS := $(filter-out -O2,$(APP_D_FLAGS)) -Oz
build/apps/editor.elf: apps/builtin/editor.d

$(BUILTIN_GUI_ELFS): $(GUI_INPUTS)
	mkdir -p "$(@D)"
	"$(LDC)" $(APP_D_FLAGS) $(APP_LINK_FLAGS) -betterC -d-version=GuiApp -d-version=$(GUI_VERSION) \
		-Iapps/builtin -Jassets/fonts -of="$@" $(GUI_COMMON) $(filter-out $(GUI_INPUTS),$^)
	@test "$$(wc -c < "$@")" -le 1048576 || { echo "App exceeds DlangFS file size limit." >&2; exit 1; }

$(KERNEL): build/kernel.elf
	mkdir -p "$(@D)"
	cp "$<" "$@"

build/kernel.elf: $(SOURCES) $(FONT_ATLASES) boot/kernel.ld Makefile config.mk
	mkdir -p "$(@D)"
	"$(LDC)" $(D_FLAGS) -link-internally -defaultlib= \
		-L=-nostdlib -L=--gc-sections -L=-z -L=max-page-size=4096 -L=-T -L=boot/kernel.ld -of="$@" $(SOURCES)

build/loader.obj: $(EFI_SOURCES) Makefile config.mk
	mkdir -p "$(@D)"
	"$(LDC)" $(EFI_D_FLAGS) -c -singleobj -of="$@" $(EFI_SOURCES)

$(BOOT_EFI): build/loader.obj Makefile config.mk
	mkdir -p "$(@D)"
	"$(LLD_LINK)" /nodefaultlib /entry:efiMain /subsystem:efi_application "/out:$@" "$<"

$(ESP)/FONT-LICENSE.txt: $(FONT_LICENSE)
	mkdir -p "$(@D)"
	cp "$<" "$@"

check-ovmf:
	@test -n "$(OVMF_CODE)" && test -r "$(OVMF_CODE)" || { \
		echo "Pass OVMF_CODE=/path/to/x86_64/OVMF_CODE.fd." >&2; exit 1; }

# Initialize only new disks and publish each image after installing the ELFs.
$(DATA_DISK): | check-ovmf all $(GUI_APP_ELFS) tools/install-apps.py tools/format-disk.py
	mkdir -p "$(@D)"
	@set -eu; temp=$$(mktemp -d "$@.XXXXXX"); trap 'rm -f "$$temp/data.img"; rmdir "$$temp"' 0; \
		"$(PYTHON)" tools/format-disk.py "$$temp/data.img"; \
		$(INSTALL_APPS) --disk "$$temp/data.img" $(INSTALL_QEMU); \
		ln "$$temp/data.img" "$@" || test -f "$@"

install-apps: $(DATA_DISK)
	$(INSTALL_APPS) --disk "$(DATA_DISK)" $(INSTALL_QEMU)

run: check-ovmf all $(DATA_DISK)
	"$(QEMU)" $(QEMU_FLAGS) $(DATA_DRIVE) -display none

run-gui: check-ovmf all $(DATA_DISK)
	"$(QEMU)" $(QEMU_FLAGS) $(DATA_DRIVE) $(if $(strip $(QEMU_DISPLAY)),-display "$(QEMU_DISPLAY)")

# Only build the ELF fixtures exercised by the essential regression suite.
test: check-ovmf all build/apps/hello.elf build/apps/vm.elf
	"$(PYTHON)" tests/qemu_shell.py "$(QEMU)" $(QEMU_FLAGS) -display none

# Standard druntime migration, isolated from the existing minimal application runtime.
# Fetch explicitly; normal builds/tests never download or consume host runtime libraries.
DRUNTIME_ARCHIVE ?=
DRUNTIME_SOURCE := build/druntime/upstream/runtime/druntime/src
.PHONY: druntime-fetch druntime-bootstrap druntime-startup druntime-audit test-druntime

druntime-fetch:
	"$(PYTHON)" tools/druntime.py fetch $(if $(DRUNTIME_ARCHIVE),--archive "$(DRUNTIME_ARCHIVE)")

druntime-bootstrap:
	"$(PYTHON)" tools/druntime.py build --ldc "$(LDC)"
	"$(LDC)" -conf=build/druntime/empty.conf $(APP_D_FLAGS) -I$(DRUNTIME_SOURCE) \
		-fno-moduleinfo $(APP_LINK_FLAGS) -L=-Map=build/druntime/bootstrap/link.map \
		-of=build/druntime/bootstrap/druntime_bootstrap.elf \
		apps/experiments/druntime_bootstrap.d apps/user_api.d \
		build/druntime/bootstrap/libdruntime-bootstrap.a
	@test "$$(wc -c < build/druntime/bootstrap/druntime_bootstrap.elf)" -le 1048576

druntime-audit:
	"$(PYTHON)" tools/druntime.py audit --ldc "$(LDC)"

druntime-startup:
	"$(PYTHON)" tools/druntime.py startup --ldc "$(LDC)" --cc "$(DRUNTIME_CC)"

test-druntime: check-ovmf all druntime-bootstrap druntime-startup
	"$(PYTHON)" tests/druntime_qemu.py "$(QEMU)" $(QEMU_FLAGS) -display none

.PHONY: druntime-package
druntime-package: druntime-bootstrap druntime-startup
	tar -czf build/druntime/druntime-bootstrap-bundle.tar.gz -C build/druntime \
		bootstrap startup ldc-source.tar.gz upstream/manifest.json \
		-C "$(CURDIR)" runtime/druntime/patches runtime/druntime/port runtime/druntime/app.ld

# Upstream Phobos std.stdio output on the static single-thread druntime port.
PHOBOS_ARCHIVE ?=
.PHONY: phobos-fetch phobos-output test-phobos phobos-package
phobos-fetch:
	"$(PYTHON)" tools/phobos.py fetch $(if $(PHOBOS_ARCHIVE),--archive "$(PHOBOS_ARCHIVE)")

phobos-output: druntime-startup
	"$(PYTHON)" tools/phobos.py build --ldc "$(LDC)"

test-phobos: check-ovmf all phobos-output
	"$(PYTHON)" tests/phobos_qemu.py "$(QEMU)" $(QEMU_FLAGS) -display none

phobos-package: druntime-package phobos-output
	tar -czf build/phobos/phobos-output-bundle.tar.gz -C "$(CURDIR)" \
		build/phobos/output build/phobos/phobos-source.tar.gz runtime/phobos \
		runtime/druntime/port runtime/druntime/app.ld tools/phobos.py tools/druntime.py \
		apps/experiments/phobos_hello.d apps/experiments/phobos_output.d \
		build/druntime/druntime-bootstrap-bundle.tar.gz
